# Server-only backend connection. Do not prefix either value with NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:8000
BACKEND_API_TOKEN=replace_with_the_same_backend_token

# LiveKit credentials are only needed for the optional recording routes.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Optional recording settings
S3_KEY_ID=
S3_KEY_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=

# Optional client settings
NEXT_PUBLIC_SHOW_SETTINGS_MENU=false
NEXT_PUBLIC_LK_RECORD_ENDPOINT=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=
NEXT_PUBLIC_DATADOG_SITE=
