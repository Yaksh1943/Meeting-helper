# Required for LiveKit room access
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-server

# Use a long random value in deployed environments. The Next.js server sends it
# to the backend; never expose it through a NEXT_PUBLIC_ variable.
BACKEND_API_TOKEN=replace_with_a_long_random_token

# Comma-separated origins allowed to call the backend directly.
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Optional AI and email integrations
GROQ_API_KEY=your_groq_api_key
# Retained for compatibility with earlier OpenAI-based configurations.
OPENAI_API_KEY=
SMTP_USER=sender@example.com
SMTP_PASS=your_smtp_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
